# Copy to .env and fill in. Non-secret settings (LLM_MODEL, USE_FAKE_LLM)
# have defaults in config.py; set them here only to override.

# Any OpenAI-compatible API. Leave unset for api.openai.com;
# for Ollama use http://localhost:11434/v1
OPENAI_BASE_URL=http://localhost:11434/v1

# Required for real LLM calls (Ollama accepts any non-empty value).
# Not needed for tests or when USE_FAKE_LLM=true.
OPENAI_API_KEY=sk-...

DATABASE_URL=sqlite:///./app.db
